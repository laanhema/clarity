+/** Drops `dropped` on the editor, as files from the file manager or as dragged text. */
+function dropOnEditor(dropped: { files?: File[]; text?: string }): void {
+  const files = dropped.files ?? []
+  const event = new Event('drop', { bubbles: true, cancelable: true })
+  Object.assign(event, { clientX: 0, clientY: 0 })
+  Object.defineProperty(event, 'dataTransfer', {
+    value: {
+      files: Object.assign([...files], { item: (index: number) => files[index] ?? null }),
+      types: files.length > 0 ? ['Files'] : ['text/plain'],
+      getData: (type: string) => (type === 'Text' || type === 'text/plain' ? (dropped.text ?? '') : ''),
+    },
+  })
+  act(() => {
+    editorView().contentDOM.dispatchEvent(event)
+  })
